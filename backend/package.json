{
  "name": "versehub-server",
  "version": "1.0.1",
  "description": "Backend API for VerseHub, a platform to write, read, and share poetry.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "^22.14.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext js,json src/server.js",
    "start": "node src/server.js",
    "check": "eslint . && node --check src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "keywords": [
    "versehub",
    "poetry",
    "creative-writing",
    "express",
    "mongodb",
    "mongoose",
    "rest-api"
  ],
  "author": "Curivon Labs",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curivonlabs/VerseHub.git",
    "directory": "backend"
  },
  "dependencies": {
    "@exortek/express-mongo-sanitize": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "slugify": "^1.6.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.0.0"
  }
}
